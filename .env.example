# Copy to .env and fill in the blanks. Never commit .env.

# --- Environment adapters (leave as-is for local) ---
APP_ENV=local
AUTH_MODE=none
INDEX_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=pmo_chunks
# Azurite's publicly documented development account; safe for local use only.
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;
BLOB_CONTAINER=pmo
INGEST_QUEUE=ingest-jobs
DATABASE_URL=postgresql+psycopg://pmo:pmo@postgres:5432/pmo

# --- Azure AI Foundry (REQUIRED: fill these in) ---
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_API_VERSION=2024-10-21
CHAT_PROVIDER=azure_openai
CHAT_DEPLOYMENT=gpt-5-mini
JUDGE_DEPLOYMENT=gpt-5-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Arize AX (REQUIRED for tracing; app runs without it, but gates P2+ need traces) ---
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=askpmo-local

# --- Runtime ---
DEFAULT_PROFILE=full
RERANKER_MODEL=BAAI/bge-reranker-base
LOG_LEVEL=INFO
