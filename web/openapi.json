{
  "openapi": "3.1.0",
  "info": {
    "title": "askPMO API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness: the process is up.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "Readiness: index, database, queue and Foundry reachable; 503 otherwise.",
        "operationId": "ready_api_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyOut"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "List Profiles",
        "description": "List profiles with their resolved toggles.",
        "operationId": "list_profiles_api_profiles_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProfileOut"
                  },
                  "type": "array",
                  "title": "Response List Profiles Api Profiles Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthOut",
        "description": "Liveness."
      },
      "ProfileOut": {
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "baseline",
              "hybrid",
              "rerank",
              "full"
            ],
            "title": "Name"
          },
          "toggles": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Toggles"
          }
        },
        "type": "object",
        "required": [
          "name",
          "toggles"
        ],
        "title": "ProfileOut",
        "description": "A profile and its resolved toggles."
      },
      "ReadyCheck": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "title": "ReadyCheck",
        "description": "Result of one dependency check."
      },
      "ReadyOut": {
        "properties": {
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ReadyCheck"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "ready",
          "checks"
        ],
        "title": "ReadyOut",
        "description": "Readiness: index, database, queue and Foundry."
      }
    }
  }
}
